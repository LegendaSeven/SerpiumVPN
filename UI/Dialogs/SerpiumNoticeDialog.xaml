<Window x:Class="SerpiumVPN.SerpiumNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serpium"
        Width="560"
        Height="390"
        MinWidth="560"
        MinHeight="390"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="NoticeButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Background" Value="#078C47"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#14C66B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0AA157"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#35E58A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#06743C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoticeCloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9696A3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#37242A"/>
                                <Setter Property="Foreground"
                                        Value="#FF7A86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoticeThumbStyle"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="7"
                                Background="#555565"
                                CornerRadius="4"
                                Margin="2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#00C875"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#35E58A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoticeScrollRepeatStyle"
               TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoticeScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="1">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource NoticeScrollRepeatStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NoticeThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource NoticeScrollRepeatStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#16161F"
            BorderBrush="#3B3B49"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.52"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            Background="#00C875"
                            CornerRadius="5"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="SERPIUM"
                                   Foreground="#F3F3F7"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderContextText"
                                   Text="  ·  Обновления компонентов"
                                   Foreground="#8F8F9C"
                                   FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource NoticeCloseButtonStyle}"
                            Content="×"
                            ToolTip="Закрыть"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="28,25,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="NoticeIconBorder"
                            Width="54"
                            Height="54"
                            Background="#123A2A"
                            BorderBrush="#288D5D"
                            BorderThickness="1"
                            CornerRadius="14"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="NoticeIconText"
                                   Text="✓"
                                   Foreground="#67EAA7"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-2,0,0"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="4,0,0,0">
                        <TextBlock x:Name="NoticeTitleText"
                                   Text="Компоненты обновлены"
                                   Foreground="#F5F5F8"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="NoticeSubtitleText"
                                   Text="Локальные файлы успешно проверены и заменены."
                                   Foreground="#9999A7"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="#12121A"
                        BorderBrush="#30303D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,18,0,0">
                    <ScrollViewer MaxHeight="185"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource NoticeScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <TextBlock x:Name="NoticeBodyText"
                                   Text=""
                                   Foreground="#C7C7D0"
                                   FontSize="13"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Padding="0,0,8,0"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Esc — закрыть"
                           Foreground="#686875"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,13,0,0"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <Grid Margin="28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterText"
                               Text="Компоненты готовы к работе."
                               Foreground="#7F7F8C"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Button Grid.Column="1"
                            Content="Готово"
                            Style="{StaticResource NoticeButtonStyle}"
                            IsDefault="True"
                            IsCancel="True"
                            Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
