; Serpium WFP clean-room P1 realtime observation driver.
; Demand-start non-PnP KMDF service. Observation only.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 09/01/2026,1.0.0.0
CatalogFile = Serpium.Wfp.Driver.cat
PnpLockdown = 1

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = SerpiumWfp,0x00000002,ServiceInstall

[DestinationDirs]
DriverCopyFiles = 12

[DriverCopyFiles]
Serpium.Wfp.Driver.sys

[ServiceInstall]
DisplayName   = %ServiceDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\Serpium.Wfp.Driver.sys

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
Serpium.Wfp.Driver.sys = 1

[Strings]
ProviderName       = "Serpium"
ServiceDisplayName = "Serpium WFP Realtime Core"
DiskName           = "Serpium WFP Realtime Core"
