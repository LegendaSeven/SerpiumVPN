                                            <TextBlock Text="Журнал движка"
                                                       Foreground="#8E8E9B"
                                                       Margin="0,12,0,6"/>
                                            <TextBox x:Name="RelayClientLogTextBox"
                                                     Style="{StaticResource RelayPageTextBoxStyle}"
                                                     Height="170"
                                                     FontFamily="Consolas"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
