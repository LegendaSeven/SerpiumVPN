                            </Border>

                            <Border Background="#16161F"
                                    BorderBrush="#292936"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Новое подключение по ключу"
                                               Foreground="#FFFFFF"
                                               FontSize="21"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Поддерживаются VLESS, VMess, Trojan и защищённые контейнеры провайдеров. Исходный ключ не записывается в журнал."
                                               Foreground="#8E8E9B"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,14"/>

                                    <TextBox x:Name="RelayClientKeyTextBox"
                                             Style="{StaticResource RelayPageTextBoxStyle}"
