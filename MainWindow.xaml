                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource RelayPageButtonStyle}"
                                                Content="Вставить ключ"
                                                Click="PasteRelayKey_Click"/>
                                        <Button x:Name="ButtonValidateRelayKey"
