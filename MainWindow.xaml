                                    <TextBlock Text="Сайты"
                                               Foreground="#FFFFFF"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Можно включить несколько доменов одновременно; при необходимости учитываются все поддомены."
                                               Foreground="#777784"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                    <TextBlock x:Name="RoutingSitesEmptyTextBlock"
                                               Text="Сайты пока не добавлены."
                                               Foreground="#777784"
                                               Margin="0,16,0,4"/>
                                    <StackPanel x:Name="RoutingSitesPanel" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource RoutingPrimaryButtonStyle}"
                                        Content="Добавить приложение или игру"
                                        Click="AddRoutingApplication_ClickAsync"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RoutingButtonStyle}"
                                        Content="Добавить сайт"
                                        Click="AddRoutingSite_ClickAsync"/>
                                <Button x:Name="ClearRoutingRegistryButton"
                                        Grid.Column="4"
                                        Style="{StaticResource RoutingDangerButtonStyle}"
                                        Content="Удалить список"
                                        IsEnabled="False"
                                        Click="ClearRoutingRegistry_ClickAsync"/>
                            </Grid>

                            <Border Background="#14141B"
                                    BorderBrush="#2A2A36"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,22">
                                <TextBlock Text="MVP7.1.1 сохраняет защищённый список и группы EXE. Реальное выборочное направление трафика через активный профиль подключается следующим сетевым патчем."
                                           Foreground="#858592"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="⚙  Настройки">
                <Grid Background="#1E1E24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34" MaxWidth="900">
                            <TextBlock Text="Настройки"
                                       Foreground="#FFFFFF"
                                       FontSize="32"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Общие параметры Serpium VPN. Настройки Zapret находятся в его собственном разделе."
                                       Foreground="#8E8E9B"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,26"/>

                            <Border Background="#14141B"
                                    BorderBrush="#2A2A36"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Обновление программы"
                                               Foreground="#FFFFFF"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,14"/>
                                    <CheckBox x:Name="CheckAutoUpdateProgram"
                                              Content="Автоматически проверять обновление Serpium VPN"
                                              Foreground="#E8E8EE"
                                              FontSize="14"
                                              Cursor="Hand"
                                              VerticalContentAlignment="Center"
                                              Checked="ProgramSettingsToggle_Changed"
                                              Unchecked="ProgramSettingsToggle_Changed">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="Border"
                                                            Grid.Column="0"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="4"
                                                            Background="#16161F"
                                                            BorderBrush="#252535"
                                                            BorderThickness="1.5"
                                                            VerticalAlignment="Center">
                                                        <Grid x:Name="CheckMark" Visibility="Collapsed">
                                                            <Border CornerRadius="2"
                                                                    Background="#008744"
                                                                    Margin="1"/>
                                                            <Path Data="M3,7 L6,10 L11,4"
                                                                  Stroke="White"
                                                                  StrokeThickness="2"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="8,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CheckMark"
                                                                Property="Visibility"
                                                                Value="Visible"/>
                                                        <Setter TargetName="Border"
                                                                Property="BorderBrush"
                                                                Value="#00FF66"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border"
                                                                Property="BorderBrush"
                                                                Value="#008744"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.48"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                    <Button x:Name="ButtonCheckAppPatch"
                                            Content="Проверить обновление программы"
                                            Height="42"
                                            Margin="0,16,0,0"
                                            Background="#087C3D"
                                            Foreground="White"
                                            BorderBrush="#14B85E"
                                            BorderThickness="1"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="CheckAppPatch_ClickAsync"/>
                                    <TextBlock x:Name="ProgramUpdateStatusText"
                                               Text="Состояние обновления ещё не проверено"
                                               Foreground="#9292A0"
                                               FontSize="12"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#14141B"
                                    BorderBrush="#2A2A36"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Локальные патчи"
                                               Foreground="#FFFFFF"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Установите последний архив Serpium*.zip из папки программы или выберите ZIP вручную."
                                               Foreground="#9292A0"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Найти рядом с программой"
                                                Height="42"
                                                Background="#252530"
                                                Foreground="#E8E8EE"
                                                BorderBrush="#343447"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="InstallLocalPatch_Click"/>
                                        <Button Grid.Column="2"
                                                Content="Выбрать ZIP вручную"
                                                Height="42"
                                                Background="#252530"
                                                Foreground="#E8E8EE"
                                                BorderBrush="#343447"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="SelectLocalPatch_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#14141B"
                                    BorderBrush="#2A2A36"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="О программе"
                                               Foreground="#FFFFFF"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AppVersionTextBlock"
                                               Text="Serpium VPN"
                                               Foreground="#71E5A8"
                                               FontSize="14"
                                               Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
