                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Приложения и игры"
                                                       Foreground="#FFFFFF"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"/>
