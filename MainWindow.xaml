<Window x:Class="SerpiumVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerpiumVPN"
        mc:Ignorable="d"
        Title="Serpium VPN" 
        Height="720" Width="1080"
        Background="#1E1E24" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="/serpium_vpn.ico">
    <Grid Background="#1E1E24">
        <TabControl x:Name="MainNavigationTabs"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0">
            <TabControl.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#17171F"
                                            BorderBrush="#2A2A36"
                                            BorderThickness="0,0,1,0">
                                        <Grid Margin="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Margin="8,14,8,24">
                                                <TextBlock Text="Serpium"
                                                           Foreground="#00A653"
                                                           FontSize="24"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="VPN Desktop"
                                                           Foreground="#7E7E8C"
                                                           FontSize="12"
                                                           Margin="1,2,0,0"/>
                                            </StackPanel>

                                            <TabPanel Grid.Row="1"
                                                      IsItemsHost="True"
                                                      KeyboardNavigation.TabIndex="1"/>

                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" Background="#1E1E24">
                                        <ContentPresenter ContentSource="SelectedContent"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Background" Value="#17171F"/>
                    <Setter Property="Foreground" Value="#3B3B49"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}"
                                      SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track"
                                           Orientation="{TemplateBinding Orientation}"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}"
                                           ViewportSize="{TemplateBinding ViewportSize}"
                                           IsDirectionReversed="True"
                                           Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Focusable="False"
                                                          Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="ScrollThumb"
                                                   MinHeight="36"
                                                   MinWidth="36"
                                                   Margin="2"
                                                   Background="#3B3B49">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder"
                                                                        Property="Background"
                                                                        Value="#008744"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder"
                                                                        Property="Background"
                                                                        Value="#00B35A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Focusable="False"
                                                          Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="10"/>
                                        <Setter Property="Width" Value="Auto"/>
                                        <Setter TargetName="PART_Track"
                                                Property="IsDirectionReversed"
                                                Value="False"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

<Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#D8D8E0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="14,12"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="NavItemBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="9"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="NavItemBorder" Property="Background" Value="#263D35"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavItemBorder" Property="Background" Value="#252530"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="⌂  Главная">
                <Grid Background="#1E1E24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34" MaxWidth="900">
                            <TextBlock Text="Главная" Foreground="#FFFFFF" FontSize="32" FontWeight="SemiBold"/>
                            <TextBlock Text="Центр управления Serpium VPN" Foreground="#8E8E9B" FontSize="14" Margin="0,6,0,26"/>

                            <UniformGrid Columns="2" Rows="1">
                                <Border Background="#14141B" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="10" Background="#263D35">
                                                <TextBlock Text="◈" Foreground="#72E3A8" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Zapret" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="Стратегии обхода, домены и обновления" Foreground="#858592" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="#17171F" CornerRadius="8" Padding="12" Margin="0,18,0,16">
                                            <TextBlock Text="Настройка стратегий обхода, доменных списков и компонентов Zapret." Foreground="#B9B9C4" FontSize="12" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Grid.Row="2" Content="Открыть Zapret" Height="40" Background="#008744" Foreground="White" BorderThickness="0" Click="OpenZapretPage_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#14141B" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="14" Padding="22" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="10" Background="#232337">
                                                <TextBlock Text="⇄" Foreground="#A8A8FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Serpium Relay" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="Внешний шлюз Serpium" Foreground="#858592" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="#17171F" CornerRadius="8" Padding="12" Margin="0,18,0,16">
                                            <TextBlock Text="Безопасная передача трафика между устройствами через Serpium Relay." Foreground="#B9B9C4" FontSize="12" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Grid.Row="2" Content="Открыть Serpium Relay" Height="40" Background="#30303D" Foreground="White" BorderThickness="0" Click="OpenRelayPage_Click"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </TabItem>

            <TabItem Header="◈  Zapret">
                    <Grid>
                        <Grid.Resources>
                
                            <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                                <Setter Property="Width" Value="34"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="#252530"/>
                                <Setter Property="Foreground" Value="#E8E8EE"/>
                                <Setter Property="BorderBrush" Value="#343447"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="{TemplateBinding Width}"
                                                  Height="{TemplateBinding Height}">
                                                <Border x:Name="BaseBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"/>
                                                <Border x:Name="InteractionOverlay"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        IsHitTestVisible="False"/>
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0"
                                                                  RecognizesAccessKey="True"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InteractionOverlay"
                                                            Property="Background"
                                                            Value="#18FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="InteractionOverlay"
                                                            Property="Background"
                                                            Value="#26000000"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="BaseBorder"
                                                            Property="BorderBrush"
                                                            Value="#00B35A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.48"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                
                                                <Border x:Name="Border" 
                                                        Grid.Column="0"
                                                        Width="16" Height="16" 
                                                        CornerRadius="4" 
                                                        Background="#16161F" 
                                                        BorderBrush="#252535" 
                                                        BorderThickness="1.5"
                                                        VerticalAlignment="Center">
                
                                                    <Grid x:Name="CheckMark" Visibility="Collapsed">
                                                        <Border CornerRadius="2" Background="#008744" Margin="1"/>
                                                        <Path Data="M3,7 L6,10 L11,4" 
                                                              Stroke="White" 
                                                              StrokeThickness="2" 
                                                              StrokeStartLineCap="Round" 
                                                              StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                
                                                <ContentPresenter Grid.Column="1" 
                                                                  Margin="8,0,0,0" 
                                                                  VerticalAlignment="Center" 
                                                                  HorizontalAlignment="Left"/>
                                            </Grid>
                
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#00FF66"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#008744"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>
                
                        <Border Grid.Column="0" Background="#111116" Margin="15" CornerRadius="12">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                
                                <Grid Grid.Row="0" Margin="0,0,0,25" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Canvas Width="20" Height="28" Margin="0,3,10,0" SnapsToDevicePixels="True">
                                            <Path Fill="#008744" Data="M9.821,27.126 C13.793,27.126 18.067,24.161 18.067,19.388 C18.067,15.681 14.789,14.654 11.233,14.053 C6.732,13.291 1.933,12.235 1.933,8.026 C1.933,4.004 6.273,0.874 10.179,0.874 C14.085,0.874 17.568,3.245 17.568,3.245 L19.123,0.0 C19.123,0.0 16.033,-1.026 10.179,-1.026 C5.68,-1.026 -0.198,1.72 -0.198,8.026 C-0.198,13.111 4.54,14.288 8.682,14.975 C12.825,15.66 16.333,16.634 16.333,19.388 C16.333,23.328 12.062,25.226 9.821,25.226 C6.719,25.226 2.016,23.012 2.016,23.012 L0.0,26.04 C0.0,26.04 4.887,27.126 9.821,27.126 Z M18.067,1.874 L16.0,1.874 C16.0,1.874 16.5,3.0 16.5,4.0 C16.5,5.0 16.0,6.0 16.0,6.0 L18.0,6.0 L18.067,1.874 Z"/>
                                        </Canvas>
                                        <TextBlock Text="erpium" Foreground="#008744" FontSize="26" FontWeight="Bold" Margin="-3,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text=" VPN" Foreground="#FFFFFF" FontSize="26" FontWeight="Light" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                
                                <Border Grid.Row="1" Background="#16161F" CornerRadius="8" Padding="15,12" Margin="0,0,0,20" BorderBrush="#252535" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" x:Name="StatusDot" Width="10" Height="10" Fill="#FF4F4F" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="DotGlow" BlurRadius="8" Color="#FF4F4F" ShadowDepth="0" Opacity="0.7"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Zapret: отключен" Foreground="#A0A0AA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                
                                <ScrollViewer Grid.Row="2"

                
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly"

                
                                              Margin="0,0,-8,0"

                
                                              Padding="0,0,8,0">

                
                                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,0">
                                    <TextBlock Text="Выберите сервисы для проверки связи:" Foreground="#888888" FontSize="12" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <CheckBox x:Name="CheckYouTube" Content="YouTube" IsChecked="True" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="CheckDiscord" Content="Discord" IsChecked="True"/>
                                    </StackPanel>

                                    <Border Background="#16161F"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,14"
                                            BorderBrush="#252535"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Telegram Desktop"
                                                       Foreground="#E8E8EE"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Отдельный WS-прогон через локальный MTProto-прокси 127.0.0.1:1443"
                                                       Foreground="#8F8F9A"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,10"/>
                                            <Button x:Name="ButtonTelegram"
                                                    Content="Запустить Telegram WS-прогон"
                                                    Height="38"
                                                    Background="#1E5AA8"
                                                    Foreground="White"
                                                    BorderBrush="#3479C9"
                                                    BorderThickness="1"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    Click="Telegram_ClickAsync"/>
                                            <TextBlock x:Name="TelegramStatusText"
                                                       Text="Готов к запуску"
                                                       Foreground="#8F8F9A"
                                                       FontSize="11"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#16161F" CornerRadius="8" Padding="12" Margin="0,0,0,14" BorderBrush="#252535" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Настройки Zapret" Foreground="#E8E8EE" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="CheckAutoSwitchStrategies"
                                                      Content="Автоматически менять стратегию при потере связи"
                                                      Margin="0,0,0,9"
                                                      Checked="ZapretSettingsToggle_Changed"
                                                      Unchecked="ZapretSettingsToggle_Changed"/>
                                            <CheckBox x:Name="CheckAutoUpdateFiles"
                                                      Content="Автоматически обновлять файлы Zapret"
                                                      Margin="0,0,0,10"
                                                      Checked="ZapretSettingsToggle_Changed"
                                                      Unchecked="ZapretSettingsToggle_Changed"/>
                                            <Button x:Name="ButtonUpdateZapretFiles"
                                                    Content="Проверить обновления файлов"
                                                    Height="34"
                                                    Background="#252530"
                                                    Foreground="#E8E8EE"
                                                    BorderBrush="#343447"
                                                    BorderThickness="1"
                                                    Click="UpdateZapretFiles_ClickAsync"/>
                                            <TextBlock x:Name="ZapretFilesStatusText"
                                                       Text="Состояние файлов ещё не проверено"
                                                       Foreground="#8F8F9A"
                                                       FontSize="11"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
<Border x:Name="AutoSelectPanel"
                                            Visibility="Visible"
                                            Background="#16161F"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,14"
                                            BorderBrush="#252535"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="AutoSelectTitle"
                                                       Text=""
                                                       Visibility="Collapsed"
                                                       Foreground="#E8E8EE"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <Border x:Name="AutoSelectProgressTrack"
                                                    Height="10"
                                                    Background="#101018"
                                                    BorderBrush="#303044"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Margin="0,0,0,8"
                                                    IsHitTestVisible="False">
                                                <Grid>
                                                    <Border x:Name="AutoSelectProgressFill"
                                                            Width="0"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="6">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00A84F" Offset="0"/>
                                                                <GradientStop Color="#00FF73" Offset="0.55"/>
                                                                <GradientStop Color="#7CFFB0" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#00FF73"
                                                                              BlurRadius="10"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.55"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="AutoSelectDetails"
                                                       Text="Готов к поиску рабочей стратегии"
                                                       Foreground="#8F8F9A"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="Способ 1 (Fake-пакеты)"
                                            Height="40"
                                            Background="#252530"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,14,0,10"
                                            Click="Strategy1_Click"/>
                                    <Button x:Name="ButtonStrategy2"
                                            Content="Способ 2 (Split / Изменение TTL)"
                                            Height="40"
                                            Background="#252530"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="Strategy2_ClickAsync"/>

                
                                

                
                                    </StackPanel>

                
                                </ScrollViewer>

                
                                <Button Grid.Row="3" Content="ОСТАНОВИТЬ" Height="45" Margin="0,14,0,0" Background="#FF4F4F" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Stop_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                
                        <Grid Grid.Column="1" Margin="0,15,15,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Список доменов (hosts):" Foreground="#CCCCCC" FontSize="14" Margin="0,5,0,8" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="1" x:Name="HostsTextBox" 
                                     Background="#111116" Foreground="#E0E0E0" 
                                     BorderBrush="#252530" BorderThickness="1"
                                     AcceptsReturn="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Padding="10">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Row="2" Content="Сохранить список" Height="35" Margin="0,12,0,0" Background="#007ACC" Foreground="White" BorderThickness="0" Click="SaveList_Click"/>
                        </Grid>
                    </Grid></TabItem>

            <TabItem Header="⇄  Serpium Relay">
                <Grid Background="#1E1E24">
                    <Grid.Resources>
                        <Style x:Key="RelayPageButtonStyle" TargetType="Button">
