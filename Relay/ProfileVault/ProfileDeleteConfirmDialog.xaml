<Window x:Class="SerpiumVPN.Relay.ProfileVault.ProfileDeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление профиля"
        Width="540"
        Height="330"
        MinWidth="540"
        MinHeight="330"
        MaxWidth="540"
        MaxHeight="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Dialog_KeyDown">

    <Window.Resources>
        <Style x:Key="DialogNeutralButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#3A3A49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343447"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00C875"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#191923"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00A862"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#65E6A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogDeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogNeutralButtonStyle}">
            <Setter Property="Background" Value="#8E2F3A"/>
            <Setter Property="BorderBrush" Value="#D25A66"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B33B49"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF7A86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#71232C"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D25A66"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF9AA3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9696A3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#37242A"/>
                                <Setter Property="Foreground" Value="#FF7A86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#261A1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#16161F"
            BorderBrush="#393947"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.46"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            Background="#00C875"
                            CornerRadius="5"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="SERPIUM"
                                   Foreground="#F3F3F7"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  Удаление профиля"
                                   Foreground="#8F8F9C"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Content="×"
                            ToolTip="Закрыть"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        Background="#33262A"
                        BorderBrush="#B9793D"
                        BorderThickness="1"
                        CornerRadius="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Text="!"
                               Foreground="#FFB35C"
                               FontSize="27"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Удалить сохранённый профиль?"
                               Foreground="#F5F5F8"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <Border Background="#101018"
                            BorderBrush="#30303D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,8"
                            Margin="0,13,0,0">
                        <TextBlock x:Name="ProfileNameTextBlock"
                                   Text="Выбранный профиль"
                                   Foreground="#BFC0CB"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>

                    <TextBlock Text="Все связанные данные этого профиля будут безвозвратно удалены из Serpium."
                               Foreground="#A0A0AD"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Margin="0,13,0,0"/>

                    <TextBlock Text="Действие нельзя отменить."
                               Foreground="#E58A94"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#14141C"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Esc — отмена"
                               Foreground="#6F6F7C"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Style="{StaticResource DialogNeutralButtonStyle}"
                            Content="Отмена"
                            IsCancel="True"
                            Click="Cancel_Click"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource DialogDeleteButtonStyle}"
                            Content="Удалить"
                            AutomationProperties.Name="Удалить профиль"
                            Click="Delete_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
