<Window x:Class="SerpiumVPN.Relay.Routing.RoutingApplicationBundleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группа приложения"
        Width="780"
        Height="690"
        MinWidth="780"
        MinHeight="690"
        MaxWidth="780"
        MaxHeight="690"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Dialog_KeyDown"
        Closing="Dialog_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="BundleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#3A3A49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#343447"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00C875"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#191923"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BundlePrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BundleButtonStyle}">
            <Setter Property="Background" Value="#087C3D"/>
            <Setter Property="BorderBrush" Value="#14B85E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="BundleCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9696A3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#37242A"/>
                                <Setter Property="Foreground" Value="#FF7A86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BundleTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#0D0D14"/>
            <Setter Property="Foreground" Value="#F3F3F7"/>
            <Setter Property="CaretBrush" Value="#33D17A"/>
            <Setter Property="BorderBrush" Value="#3B3B49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="BundleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D8E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,3,0,0"
                                    Background="#0D0D14"
                                    BorderBrush="#4A4A59"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="8"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#00C875"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#14231B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#087C3D"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#14B85E"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#70E5A6"/>
                                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.68"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#16161F"
            BorderBrush="#393947"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.46"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="10"
                            Height="10"
                            Background="#00C875"
                            CornerRadius="5"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="SERPIUM"
                                   Foreground="#F3F3F7"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  ·  Группа приложения"
                                   Foreground="#8F8F9C"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource BundleCloseButtonStyle}"
                            Content="×"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Проверьте состав приложения"
                           Foreground="#F5F5F8"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1"
                           Text="Serpium направит через VPN все отмеченные EXE как одну группу. Основной файл снять нельзя."
                           Foreground="#9696A3"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,6,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Название карточки"
                                   Foreground="#B5B5C0"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="DisplayNameTextBox"
                                 Style="{StaticResource BundleTextBoxStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="RescanButton"
                            Style="{StaticResource BundleButtonStyle}"
                            Content="Повторить поиск"
                            VerticalAlignment="Bottom"
                            Click="Rescan_ClickAsync"/>
                    <Button Grid.Column="4"
                            x:Name="ObserveButton"
                            Style="{StaticResource BundlePrimaryButtonStyle}"
                            Content="Наблюдать запуск (30 с)"
                            VerticalAlignment="Bottom"
                            Click="Observe_ClickAsync"/>
                </Grid>

                <Border Grid.Row="3"
                        Background="#101018"
                        BorderBrush="#30303D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,12,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ObservationStatusTextBlock"
                                       Text="Статический поиск завершён. Можно запустить наблюдение и затем открыть приложение или игру."
                                       Foreground="#A8A8B3"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="PrimaryPathTextBlock"
                                       Foreground="#666674"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,16,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   x:Name="CandidatesCountTextBlock"
                                   Foreground="#65E6A4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="#0E0E15"
                        BorderBrush="#30303D"
                        BorderThickness="1"
                        CornerRadius="10">
                    <ListBox x:Name="CandidatesListBox"
                             ItemsSource="{Binding Candidates}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16161F"
                                        BorderBrush="#2C2C39"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="11,9">
                                    <CheckBox Style="{StaticResource BundleCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanToggle, Mode=OneWay}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductName, Mode=OneWay}"
                                                       Foreground="#F0F0F4"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Background="#1D3B2C"
                                                    CornerRadius="5"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding IsPrimary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="ОСНОВНОЙ"
                                                           Foreground="#72E8AA"
                                                           FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Background="#252542"
                                                    CornerRadius="5"
                                                    Padding="7,2"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding IsObserved, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="НАБЛЮДЕНИЕ"
                                                           Foreground="#B7B4FF"
                                                           FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       Text="{Binding ExecutablePath, Mode=OneWay}"
                                                       Foreground="#787886"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExecutablePath, Mode=OneWay}"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="3"
                                                       Foreground="#9898A5"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SourceDescription, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#14141C"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedCountTextBlock"
                               Text="Выбрано EXE: 0"
                               Foreground="#747481"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource BundleButtonStyle}"
                            Content="Отмена"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="3"
                            x:Name="SaveButton"
                            Style="{StaticResource BundlePrimaryButtonStyle}"
                            Content="Сохранить группу"
                            Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
