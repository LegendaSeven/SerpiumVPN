<Window x:Class="SerpiumVPN.Relay.Components.RelayComponentActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение операции Relay"
        Width="640"
        Height="455"
        MinWidth="640"
        MinHeight="455"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="DialogSecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#F1F1F5"/>
            <Setter Property="BorderBrush" Value="#3A3A49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#30303D"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#56566A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E1E28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Background" Value="#078C47"/>
            <Setter Property="BorderBrush" Value="#14C66B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0AA157"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#35E58A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#06743C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogRollbackButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Background" Value="#76540D"/>
            <Setter Property="BorderBrush" Value="#D59B23"/>
            <Setter Property="Foreground" Value="#FFF6DE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8C6514"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#F0B842"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#614408"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9696A3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#37242A"/>
                                <Setter Property="Foreground"
                                        Value="#FF7A86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#16161F"
            BorderBrush="#3B3B49"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Opacity="0.52"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            Background="#00C875"
                            CornerRadius="5"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="SERPIUM"
                                   Foreground="#F3F3F7"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  ·  Безопасная операция Relay"
                                   Foreground="#8F8F9C"
                                   FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Content="×"
                            ToolTip="Закрыть"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="28,24,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ComponentBadgeBorder"
                            Width="54"
                            Height="54"
                            Background="#262040"
                            BorderBrush="#6858D8"
                            BorderThickness="1"
                            CornerRadius="14"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="ComponentBadgeText"
                                   Text="X"
                                   Foreground="#B7A7FF"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="4,0,0,0">
                        <TextBlock x:Name="ActionTitleText"
                                   Text="Установка компонента Relay"
                                   Foreground="#F5F5F8"
                                   FontSize="25"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActionSubtitleText"
                                   Text="Проверьте параметры перед продолжением."
                                   Foreground="#9999A7"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        x:Name="WarningBorder"
                        Background="#1C1A16"
                        BorderBrush="#6E5724"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,18,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="26"
                                Height="26"
                                Background="#5E4612"
                                BorderBrush="#D8A733"
                                BorderThickness="1"
                                CornerRadius="13"
                                VerticalAlignment="Top">
                            <TextBlock Text="!"
                                       Foreground="#FFE4A0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Border>

                        <TextBlock x:Name="WarningText"
                                   Grid.Column="1"
                                   Text="Активный Relay будет временно остановлен."
                                   Foreground="#E9D7A9"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#12121A"
                            BorderBrush="#30303D"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Текущая версия"
                                       Foreground="#848491"
                                       FontSize="11"/>
                            <TextBlock x:Name="CurrentVersionText"
                                       Text="1.8.9"
                                       Foreground="#F0F0F5"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="→"
                               Foreground="#6E6E7C"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="2"
                            x:Name="TargetVersionBorder"
                            Background="#11251C"
                            BorderBrush="#287C52"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="TargetVersionLabelText"
                                       Text="Новая версия"
                                       Foreground="#75C79B"
                                       FontSize="11"/>
                            <TextBlock x:Name="TargetVersionText"
                                       Text="v26.3.27"
                                       Foreground="#71F2AA"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="Esc — отмена"
                           Foreground="#686875"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,14,0,0"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <Grid Margin="28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterHintText"
                               Text="Операция будет выполнена локально."
                               Foreground="#7F7F8C"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Button Grid.Column="1"
                            Content="Отмена"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            IsCancel="True"
                            Click="Cancel_Click"/>

                    <Button x:Name="ConfirmButton"
                            Grid.Column="3"
                            Content="Установить"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            IsDefault="True"
                            Click="Confirm_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
