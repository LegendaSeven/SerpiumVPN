<Window x:Class="SerpiumVPN.Relay.Components.RelayComponentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Serpium Relay"
        Width="860"
        Height="760"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RelaySettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="#F1F1F5"/>
            <Setter Property="BorderBrush" Value="#3A3A49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#333342"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00C875"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#191922"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelaySettingsPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RelaySettingsButtonStyle}">
            <Setter Property="Background" Value="#087C3D"/>
            <Setter Property="BorderBrush" Value="#14B85E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="RelaySettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    Background="#101018"
                                    BorderBrush="#4A4A5A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           Margin="0,-1,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#087C3D"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#32E88A"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#65E6A4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelayScrollThumbStyle"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="7"
                                Background="#51515F"
                                CornerRadius="4"
                                Margin="2,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#00C875"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#35E58A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbBorder"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelayScrollRepeatButtonStyle"
               TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RelayVerticalScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#101018"/>
            <Setter Property="Margin" Value="2,6,3,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#272733"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource RelayScrollRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RelayScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource RelayScrollRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Height"
                            Value="0"/>
                    <Setter Property="Width"
                            Value="Auto"/>
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RelaySettingsCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9696A3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#37242A"/>
                                <Setter Property="Foreground" Value="#FF7A86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#16161F"
            BorderBrush="#393947"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.46"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#191922"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="10"
                            Height="10"
                            Background="#00C875"
                            CornerRadius="5"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="SERPIUM"
                                   Foreground="#F3F3F7"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  ·  Компоненты Relay"
                                   Foreground="#8F8F9C"
                                   FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource RelaySettingsCloseButtonStyle}"
                            Content="×"
                            ToolTip="Закрыть"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          CanContentScroll="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource RelayVerticalScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="26,22,22,24">
                    <TextBlock Text="Настройки Serpium Relay"
                               Foreground="#F5F5F8"
                               FontSize="26"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Проверка sing-box и Xray Core. Zapret, winws и WinDivert этим окном не затрагиваются."
                               Foreground="#9999A7"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18"/>

                    <Border Background="#12121A"
                            BorderBrush="#2D2D3A"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="AutoCheckRelayComponentsCheckBox"
                                      Style="{StaticResource RelaySettingsCheckBoxStyle}"
                                      Content="Автоматически проверять обновления компонентов Serpium Relay"
                                      Checked="AutoCheckRelayComponents_Changed"
                                      Unchecked="AutoCheckRelayComponents_Changed"/>
                            <TextBlock x:Name="LastCheckTextBlock"
                                       Text="Последняя проверка: ещё не выполнялась"
                                       Foreground="#81818E"
                                       FontSize="12"
                                       Margin="30,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OverallStatusBorder"
                            Background="#171720"
                            BorderBrush="#343442"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="OverallStatusIndicator"
                                     Width="10"
                                     Height="10"
                                     Fill="#777783"
                                     VerticalAlignment="Top"
                                     Margin="0,4,12,0"/>
                            <TextBlock x:Name="OverallStatusTextBlock"
                                       Grid.Column="1"
                                       Text="Загружаю локальную инвентаризацию компонентов..."
                                       Foreground="#B9B9C4"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Background="#111119"
                            BorderBrush="#2C2C39"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46"
                                        Background="#18372B"
                                        BorderBrush="#2E8E61"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <TextBlock Text="S"
                                               Foreground="#55E7A0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                    <TextBlock Text="sing-box"
                                               Foreground="#F3F3F7"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="TUN, DNS, AVO-профили и выборочная маршрутизация"
                                               Foreground="#8F8F9C"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        x:Name="SingBoxStatusChip"
                                        Background="#24242E"
                                        BorderBrush="#3A3A47"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,5"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="SingBoxStatusChipText"
                                               Text="Проверка"
                                               Foreground="#B9B9C4"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Установлена" Foreground="#81818E"/>
                                <TextBlock x:Name="SingBoxInstalledVersionText" Grid.Column="1" Text="—" Foreground="#E7E7EC" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Стабильный релиз" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="SingBoxLatestVersionText" Grid.Row="1" Grid.Column="1" Text="не проверялся" Foreground="#C7C7D0" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Text="Путь" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="SingBoxPathText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#AFAFBA" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Text="SHA-256" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="SingBoxHashText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#AFAFBA" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>

                            <TextBlock x:Name="SingBoxHealthText"
                                       Text="Локальная проверка ещё не выполнена."
                                       Foreground="#AFAFBA"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>

                            <Border x:Name="SingBoxStagingBorder"
                                    Background="#15151E"
                                    BorderBrush="#343447"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SingBoxStagingText"
                                               Text="Staging: обновление ещё не загружено."
                                               Foreground="#8F8F9C"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel HorizontalAlignment="Right"
                                               Margin="0,12,0,0">
                                        <Button x:Name="SingBoxRollbackButton"
                                                Content="Вернуть предыдущую"
                                                Width="190"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="RollbackSingBox_ClickAsync"/>
                                        <Button x:Name="SingBoxDeleteStageButton"
                                                Content="Удалить загруженное"
                                                Width="160"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="DeleteSingBoxStage_ClickAsync"/>
                                        <Button x:Name="SingBoxStageButton"
                                                Content="Скачать обновление"
                                                Width="175"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="StageSingBox_ClickAsync"/>
                                        <Button x:Name="SingBoxInstallButton"
                                                Content="Установить"
                                                Width="160"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsPrimaryButtonStyle}"
                                                Click="InstallSingBox_ClickAsync"/>
                                        <Button Content="Проверить sing-box"
                                                Width="170"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="CheckSingBox_ClickAsync"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#111119"
                            BorderBrush="#2C2C39"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46"
                                        Background="#252243"
                                        BorderBrush="#665CC6"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <TextBlock Text="X"
                                               Foreground="#A89CFF"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                    <TextBlock Text="Xray Core"
                                               Foreground="#F3F3F7"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="VLESS, VMess, Trojan, Reality и локальный SOCKS5"
                                               Foreground="#8F8F9C"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        x:Name="XrayStatusChip"
                                        Background="#24242E"
                                        BorderBrush="#3A3A47"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,5"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="XrayStatusChipText"
                                               Text="Проверка"
                                               Foreground="#B9B9C4"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Установлена" Foreground="#81818E"/>
                                <TextBlock x:Name="XrayInstalledVersionText" Grid.Column="1" Text="—" Foreground="#E7E7EC" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Стабильный релиз" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="XrayLatestVersionText" Grid.Row="1" Grid.Column="1" Text="не проверялся" Foreground="#C7C7D0" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Text="Путь" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="XrayPathText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#AFAFBA" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Text="SHA-256" Foreground="#81818E" Margin="0,8,0,0"/>
                                <TextBlock x:Name="XrayHashText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#AFAFBA" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>

                            <TextBlock x:Name="XrayHealthText"
                                       Text="Локальная проверка ещё не выполнена."
                                       Foreground="#AFAFBA"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>

                            <Border x:Name="XrayStagingBorder"
                                    Background="#15151E"
                                    BorderBrush="#343447"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="XrayStagingText"
                                               Text="Staging: обновление ещё не загружено."
                                               Foreground="#8F8F9C"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel HorizontalAlignment="Right"
                                               Margin="0,12,0,0">
                                        <Button x:Name="XrayRollbackButton"
                                                Content="Вернуть предыдущую"
                                                Width="190"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="RollbackXray_ClickAsync"/>
                                        <Button x:Name="XrayDeleteStageButton"
                                                Content="Удалить загруженное"
                                                Width="160"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="DeleteXrayStage_ClickAsync"/>
                                        <Button x:Name="XrayStageButton"
                                                Content="Скачать обновление"
                                                Width="175"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="StageXray_ClickAsync"/>
                                        <Button x:Name="XrayInstallButton"
                                                Content="Установить"
                                                Width="160"
                                                Margin="0,0,10,10"
                                                Visibility="Collapsed"
                                                Style="{StaticResource RelaySettingsPrimaryButtonStyle}"
                                                Click="InstallXray_ClickAsync"/>
                                        <Button Content="Проверить Xray Core"
                                                Width="170"
                                                Margin="0,0,0,10"
                                                Style="{StaticResource RelaySettingsButtonStyle}"
                                                Click="CheckXray_ClickAsync"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#14141C"
                    BorderBrush="#2C2C39"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <Grid Margin="24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Источники: официальные GitHub Releases SagerNet/sing-box и XTLS/Xray-core"
                               Foreground="#747481"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"/>

                    <Button x:Name="RefreshLocalButton"
                            Grid.Column="1"
                            Content="Обновить данные"
                            Width="150"
                            Margin="0,0,10,0"
                            Style="{StaticResource RelaySettingsButtonStyle}"
                            Click="RefreshLocal_ClickAsync"/>

                    <Button x:Name="CheckUpdatesButton"
                            Grid.Column="2"
                            Content="Проверить обновления"
                            Width="190"
                            Style="{StaticResource RelaySettingsPrimaryButtonStyle}"
                            Click="CheckUpdates_ClickAsync"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
