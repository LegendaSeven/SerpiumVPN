; Serpium Flow WFP-4A guarded TCP route-enforcement driver
; This package installs a demand-start, non-PnP KMDF kernel service.
; TCP redirect is disarmed by default and protected by a renewable fail-open lease.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 08/09/2026,4.0.0.0
CatalogFile = Serpium.Flow.Driver.cat
PnpLockdown = 1

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = SerpiumFlow,0x00000002,ServiceInstall

[DefaultUninstall.NTamd64]
DelFiles = DriverCopyFiles

[DefaultUninstall.NTamd64.Services]
DelService = SerpiumFlow,0x00000200

[DestinationDirs]
DriverCopyFiles = 12

[DriverCopyFiles]
Serpium.Flow.Driver.sys

[ServiceInstall]
DisplayName   = %ServiceDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\Serpium.Flow.Driver.sys

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
Serpium.Flow.Driver.sys = 1

[Strings]
ProviderName       = "Serpium"
ServiceDisplayName = "Serpium Flow WFP-4A TCP Route Driver"
DiskName           = "Serpium Flow WFP-4A TCP Route Driver"
