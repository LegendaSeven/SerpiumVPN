<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Serpium.App.ico</ApplicationIcon>
    <AssemblyVersion>1.0.56.8</AssemblyVersion>
    <FileVersion>1.0.56.8</FileVersion>
    <Version>1.0.56.8</Version>
    <VersionPrefix>1.0.56.8</VersionPrefix>
    <InformationalVersion>1.0.56.8</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SerpiumUpdater\**\*.cs" />
    <None Remove="SerpiumUpdater\**\*;Assets\Serpium.App.ico;Assets\Serpium.png" />
    <Resource Include="Assets\Serpium.App.ico;Assets\Serpium.png" />
    <!-- Keep the shortcut's file copy without registering this resource as WPF Content. -->
    <None Include="Assets\Serpium.App.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Only the two supported transports belong in the application package. -->
    <None Update="bin_files\relay\sing-box.exe;bin_files\relay\xray.exe;bin_files\relay\sing-box.version.txt;bin_files\relay\xray.version.json;bin_files\relay\README_XRAY.txt;THIRD_PARTY_NOTICES.txt;licenses\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
